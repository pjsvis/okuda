#!/usr/bin/expect -f
# dogfood-heading-hint.exp — the editor hint, driven through the REAL TUI on
# a real pty (BRF-HEADING-EDITOR-HINT / BRF-CODE-EDITOR-HINT).
#
# `88` spawns an editor. We do NOT want a real window, so a fake `zed` on a
# temporary PATH logs its argv and exits. The verb, the derivation and the
# spawn all run for real; only the editor is observed. The doubled pair needs
# TWO terminal reads (the run buffer latches across reads), so each tap is
# followed by an `expect` for a frame — the pattern dogfood-pending.exp uses.
#
# Two cases, both at the initial frame so no key-count assumptions:
#   1. markdown fixture — viewport middle is in "## Second" (source 9) -> :9
#   2. code fixture     — top frame clamps to source line 1 -> :1
#   3. code after three j — scroll 3 maps to source line 2 -> :2
#      (indices 0/1 are header and blank, so scroll 2 is still line 1)
#
# The markdown expectation is the viewport MIDDLE, not the first heading:
# the fixture is 15 lines and the glass 12, so the eye proxy sits at 9.
#
# Run: expect scripts/dogfood-heading-hint.exp

set timeout 5
set here [pwd]
set log "$here/tmp/hint-dogfood.log"
set fake "$here/tmp/hint-editor.sh"
exec sh -c "rm -f $log"
exec sh -c "mkdir -p $here/tmp/fakebin"
exec sh -c "cp $fake $here/tmp/fakebin/zed"
# Self-contained fixtures: the dogfood owns the shapes it asserts against.
exec sh -c "printf '# Top\n\nintro\n\n## First\n\na\n\n## Second\n\nb\n\n## Third\n\nc\n' > $here/tmp/hint-fixture.md"
exec sh -c "for i in \$(seq 1 40); do echo \"const line\$i = \$i;\"; done > $here/tmp/hint-offset.ts"

set env(PATH) "$here/tmp/fakebin:$env(PATH)"
set env(OKUDA_EDITOR) ""
set env(OKUDA_HINT_LOG) $log
set env(OKUDA_CLONE) "ghostty-edit"

set failures 0
proc check {ok msg} {
  global failures
  if {$ok} { puts "  PASS  $msg" } else { puts "  FAIL  $msg"; incr failures }
}
proc lastLog {} {
  global log
  if {![file exists $log]} { return "" }
  set f [open $log r]
  set data [read $f]
  close $f
  set lines [split [string trim $data] "\n"]
  return [lindex $lines end]
}
proc clearLog {} { global log; exec sh -c "rm -f $log" }
proc tap88 {} {
  send -- "8"
  expect -re {\? help} { }
  send -- "8"
  expect -re {\? help} { }
  after 400 ;# async edit() reads source, derives, spawns
}
proc quitTui {} {
  send -- "0"
  expect -re {\? help} { }
  send -- "0"
  expect eof
}

puts "=== the editor hint, on the glass ===\n"

# ── 1. markdown: the initial viewport is in the first section ──
spawn -noecho ./okuda tmp/hint-fixture.md --tui
expect -re {\? help} { }
tap88
check [expr {[string first "hint-fixture.md:9" [lastLog]] >= 0}] \
  "markdown: the viewport-middle heading resolves to :9 (got: [lastLog])"
quitTui
clearLog

# ── 2. code: the initial viewport top is source line 1 ──
spawn -noecho ./okuda tmp/hint-offset.ts --tui
expect -re {\? help} { }
tap88
check [expr {[string first "hint-offset.ts:1" [lastLog]] >= 0}] \
  "code: the top row resolves to :1 (got: [lastLog])"
quitTui
clearLog

# ── 3. code after a scroll ──
spawn -noecho ./okuda tmp/hint-offset.ts --tui
expect -re {\? help} { }
for {set i 0} {$i < 3} {incr i} {
  send -- "j"
  expect -re {\? help} { }
}
tap88
check [expr {[string first "hint-offset.ts:2" [lastLog]] >= 0}] \
  "code: three j moves the hint to :2 (got: [lastLog])"
quitTui

puts ""
if {$failures > 0} { puts "$failures FAILURE(S)"; exit 1 }
puts "ALL PASS"
